# Compose reads this file and injects it as environment variables.
# The application itself reads ENV ONLY -- it never parses .env (12-factor).
# Copy to .env and adjust. .env is gitignored.

# Volumes live on F: -- D: has only ~29 GB free. This is the path the DOCKER
# DAEMON sees, NOT a Windows path. The volumes use driver_opts {type: none, o:
# bind, device: ${COMPOSE_DATA_ROOT}/...}, and that device is resolved INSIDE
# Docker Desktop's Linux VM, where the Windows `F:\` drive is mounted at
# /run/desktop/mnt/host/f. A literal `F:/fdi-data` fails at `up` with
#   failed to mount local volume ... F:/fdi-data/rabbitmq ... no such file or directory
# because the VM has no `F:` drive. So: CREATE the dirs Windows-side
# (New-Item F:/fdi-data/...), but REFERENCE them here VM-side. (WSL2 backend;
# /mnt/host/f and /host_mnt/f are aliases of the same mount on this box.)
#
# NOT FDI_-prefixed, deliberately. `FDI_` is reserved for Settings fields and
# nothing else -- the app rejects any unknown FDI_ var it can see, so a
# Compose-only var wearing that prefix is a landmine: the moment someone adds
# `env_file:` to a service, the app refuses to boot citing a variable that is
# legitimately required from the operator's point of view. That reads as a false
# positive and invites weakening the validator. Every other Compose-only var here
# (POSTGRES_*, MINIO_*, RABBITMQ_*) already sits outside FDI_; this restores that
# rule rather than inventing one.
COMPOSE_DATA_ROOT=/run/desktop/mnt/host/f/fdi-data

POSTGRES_USER=fdi
POSTGRES_PASSWORD=fdi
POSTGRES_DB=fdi

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

FDI_DATABASE_URL=postgresql+asyncpg://fdi:fdi@postgres:5432/fdi
FDI_BROKER_URL=amqp://guest:guest@rabbitmq:5672/%2F
FDI_RESULT_BACKEND=redis://redis:6379/0
FDI_S3_ENDPOINT=minio:9000
# The endpoint used to PRESIGN download URLs, distinct from FDI_S3_ENDPOINT above.
# put/get run in-network against minio:9000; presigned URLs are handed to a host
# browser, which cannot resolve `minio`. `localhost:9000` matches the published
# `9000:9000` port, so the signed artifact_url is fetchable from the host. (If minio
# is remapped to another host port, this must match it, since the port is signed in.)
FDI_S3_PUBLIC_ENDPOINT=localhost:9000
FDI_S3_ACCESS_KEY=minioadmin
FDI_S3_SECRET_KEY=minioadmin
FDI_S3_BUCKET=artifacts
FDI_S3_SECURE=false
FDI_WORKER_CONCURRENCY=2
FDI_LOG_LEVEL=INFO
# Every Settings field with a default must STILL be listed here, because
# x-backend-env interpolates `${FDI_ARTIFACT_URL_TTL_SECONDS}` unconditionally. An
# absent var interpolates to the empty string, and Compose injects
# FDI_ARTIFACT_URL_TTL_SECONDS="" into the container -- a value pydantic parses as
# an int and REJECTS ("unable to parse string as an integer"), so the app crashes
# at boot instead of using its default. The default only applies when the var is
# absent from os.environ, which it never is once Compose sets it. Leaving this out
# does not silently fall back; it takes the whole stack down at migrate.
FDI_ARTIFACT_URL_TTL_SECONDS=3600
FDI_MAX_UPLOAD_MB=50
# Azure Document Intelligence. Endpoint/key are optional (str | None) -- empty is
# legal and the stack boots without Azure configured. Copy real values from the
# sibling D:\FinancialDocIntelligence\.env when OCR against live Azure is needed.
FDI_AZURE_DI_ENDPOINT=
FDI_AZURE_DI_KEY=
FDI_AZURE_DI_MODEL=prebuilt-layout
FDI_AZURE_DI_API_VERSION=2024-11-30
FDI_AZURE_DI_POLLING_TIMEOUT_S=600
# Azure OpenAI (GPT). Endpoint/key are optional (str | None) -- empty is legal
# and the stack boots without it configured. Copy real values from the sibling
# D:\FinancialDocIntelligence\.env (there named bare GPT_*), renamed on the way
# in: GPT_SUBSCRIPTION_KEY -> FDI_GPT_KEY, GPT_ENDPOINT -> FDI_GPT_ENDPOINT,
# GPT_DEPLOYMENT -> FDI_GPT_DEPLOYMENT, GPT_MODEL_NAME -> FDI_GPT_MODEL,
# GPT_API_VERSION -> FDI_GPT_API_VERSION.
FDI_GPT_ENDPOINT=
FDI_GPT_KEY=
FDI_GPT_DEPLOYMENT=gpt-4o
FDI_GPT_MODEL=gpt-4o
FDI_GPT_API_VERSION=2024-10-21
# BGE-small embeddings (fastembed, local CPU/ONNX) -- swapped in at SP-13b,
# replacing SP-13's Azure OpenAI embedding backend. No endpoint/key: the model
# runs locally, downloaded once (~130 MB) to fastembed's local cache on first
# use. FDI_EMBED_DIM (384) is the model's native output size, not a request
# parameter -- change it only alongside FDI_EMBED_MODEL.
FDI_EMBED_MODEL=BAAI/bge-small-en-v1.5
FDI_EMBED_DIM=384
# Neo4j (graph loader, SP-9b). Self-hosted via the `graph` Compose profile
# (docker compose --profile graph up) -- unlike Azure DI/OpenAI above, these
# are NOT blank: FDI_NEO4J_USER/FDI_NEO4J_PASSWORD also become the neo4j
# service's own NEO4J_AUTH bootstrap credential, so the profile must have a
# working password the moment it is started.
FDI_NEO4J_URI=bolt://neo4j:7687
FDI_NEO4J_USER=neo4j
FDI_NEO4J_PASSWORD=fdipassword
# Milvus (vector index, SP-14). Self-hosted via the `vector` Compose profile
# (docker compose --profile vector up) -- like Neo4j above (and unlike Azure
# DI/OpenAI/embeddings), this is NOT blank: a working default URI, though
# unlike Neo4j there is no username/password pair to keep in sync, since
# Milvus standalone has no bootstrap credential of its own.
# WARNING: `vector` (etcd+milvus) is the memory-heavy Compose profile -- see
# README's profile-memory table (~5 GB estimated) before bringing it up on a
# constrained Docker VM.
# Schema v2 (RT-9): dense vector + BM25 sparse vector + stored text. The BM25
# Function cannot be added to an existing collection, so the cutover is a NEW
# collection rather than an alter -- `fdi_sections` is left in place, which
# makes rollback a one-line revert of this default.
FDI_MILVUS_URI=http://milvus:19530
FDI_MILVUS_COLLECTION=fdi_chunks_v2
# Cross-document entity resolution (SP-16): cosine threshold for clustering
# document embedding vectors into entities. Override per-request via the
# POST /entities/resolve body; this is the default.
FDI_ENTITY_SIM_THRESHOLD=0.85

# Costing (docs/superpowers/specs/2026-07-28-costing-feature-design.md).
# OCR billed flat per page; LLM billed per Azure OpenAI's own $/M-token
# pricing, converted to INR at read time via this rate.
FDI_OCR_COST_PER_PAGE_INR=1.0
FDI_LLM_INPUT_COST_PER_MTOK_USD=2.5
FDI_LLM_OUTPUT_COST_PER_MTOK_USD=10.0
FDI_USD_TO_INR_RATE=95.0

# Browser origins allowed to read this API's responses cross-origin. A JSON
# ARRAY, not a comma-separated list: pydantic-settings parses a complex-typed
# field from the environment as JSON. This REPLACES the allowlist -- listing
# a production origin drops localhost:3000 unless it is listed again. Never
# set this to ["*"]: that grants every site on the internet read access to
# this API from a logged-in user's browser.
FDI_CORS_ORIGINS=["http://localhost:3000"]
# Extractor pipeline: schema-driven RAG field extraction over
# POST /extract/document. Settings' own default is computed from the
# package's on-disk location (cwd-independent), which is correct for local
# `uv run` but does NOT reach into the built image (the installed package
# lives under .venv/site-packages there, not backend/src/). This value is
# relative to the container's WORKDIR (/app) instead, matching where
# backend/Dockerfile COPYs the schema file -- override only to point at a
# different schema file/version.
FDI_EXTRACTION_SCHEMA_PATH=docs/architecture/field-extraction-schema.v4_2.json

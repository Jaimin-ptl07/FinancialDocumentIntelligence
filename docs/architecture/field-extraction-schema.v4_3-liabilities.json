              "derivation": {"method":"sum","inputs":["TL","WCL","WCL2","STBP","LROD","ICBOR","BORFIA","BCP","DPL","BSD","BLNARPT","BND","BOTLNA","LOC","OTBR","STMA","LTMA","STLPS","LTPS"]},
              "fields": [
                {"tag":"TL","field_name":"Term loans","sr_no":"1.1","origin":"derived","note_aliases":["term loans"],
                 "derivation":{"method":"sum","inputs":["STLRTL","LTRTL"]},
                 "fields":[{"tag":"STLRTL","field_name":"Term loans - current","origin":"extracted","data_type":"decimal"},
                           {"tag":"LTRTL","field_name":"Term loans - non-current","origin":"extracted","data_type":"decimal"}]},

                {"tag":"WCL","field_name":"Working capital loans","sr_no":"1.2","origin":"derived",
                 "note_aliases":["working capital loans","cash credit","short term loan","packing credit","invoice financing"],

                           {"tag":"STOTBRO","field_name":"Other borrowings - current, due after more than one year","origin":"extracted","data_type":"decimal"},
                           {"tag":"STLTBRO","field_name":"Other borrowings - current, due within one year","origin":"extracted","data_type":"decimal"},
                           {"tag":"LTOTBRO","field_name":"Other borrowings - non-current","origin":"extracted","data_type":"decimal"}]},

                {"tag":"STMA","field_name":"Mobilisation advance - current portion","sr_no":"1.16","origin":"extracted","data_type":"decimal"},
                {"tag":"LTMA","field_name":"Mobilisation advance - non-current portion","sr_no":"1.17","origin":"extracted","data_type":"decimal"},
                {"tag":"STLPS","field_name":"Instalments of liabilities due within one year","sr_no":"1.18","origin":"extracted","data_type":"decimal","note_aliases":["current maturities of long-term debt"]},

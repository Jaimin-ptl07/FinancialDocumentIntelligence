  "reporting_unit": "as reported",
  "design_rules": {
    "see": "field-extraction-schema.v4_3-pl.json carries the full rule text; the same seven rules apply here.",
    "current_noncurrent_is_a_split_not_a_hierarchy": "Almost every liability here is reported twice -- a current and a non-current portion -- and the taxonomy tags each separately (STxxx / LTxxx). The concept is the PARENT; the two portions are its children and sum to it. This is why `TL` composes STLRTL + LTRTL rather than being a leaf.",
    "the_sheet_subtotal_is_not_the_container": "TOTBOR is explicitly 'Total Borrowings (1.1 to 1.13)', so it EXCLUDES line of credit, other borrowings, mobilisation advances and preference shares at 1.14-1.19. A `BOR` container holds all of 1.x; TOTBOR is a waterfall over the range the sheet actually names. Collapsing the two would silently widen the issuer's own subtotal."
  },
  "modules": [
    {
      "key": "module_liabilities",
      "name": "Liabilities",
      "statement": "liabilities",
      "retrieval_units": [
        {
          "unit_id": "LI",
          "statement_type": "liabilities",
          "basis_preference": "standalone",
          "fields": [

            { "tag": "BOR", "field_name": "Borrowings", "sr_no": "1",
              "origin": "derived",
              "note_aliases": ["borrowings", "financial liabilities borrowings"],

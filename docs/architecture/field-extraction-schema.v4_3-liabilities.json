                 "note_aliases":["buyers credit","buyer's credit"],
                 "definition":"The sheet reuses the code WCL for this concept as well as for working-capital loans. Two structurally different concepts cannot share one tag -- every tag-keyed structure downstream keeps the first and discards the second -- so this one is WCL2 and the customer's original code is kept as taxonomy_tag.",
                 "derivation":{"method":"sum","inputs":["STBYCRD","LTBYCRD"]},
                 "fields":[{"tag":"STBYCRD","field_name":"Buyers Credit - current","origin":"extracted","data_type":"decimal"},
                           {"tag":"LTBYCRD","field_name":"Buyers Credit - non-current","origin":"extracted","data_type":"decimal"}]},

                {"tag":"STBP","field_name":"Bill discounting and bill purchasing","sr_no":"1.4","origin":"extracted","data_type":"decimal"},

                 "derivation":{"method":"sum","inputs":["WCLI","WCLB","WCLO"]},
                 "fields":[{"tag":"WCLI","field_name":"Working capital loans - from ICICI Bank","origin":"extracted","data_type":"decimal"},
                           {"tag":"WCLB","field_name":"Working capital loans - from other banks","origin":"extracted","data_type":"decimal"},
                           {"tag":"WCLO","field_name":"Working capital loans - from others","origin":"extracted","data_type":"decimal"}]},

